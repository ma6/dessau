# ---------------------------------------------------------------------------
# Local source and reference material — never part of Dessau's Git history.
# ---------------------------------------------------------------------------
/src/

# ---------------------------------------------------------------------------
# Local bootstrap instructions (contain source-project context by nature).
# ---------------------------------------------------------------------------
/DESSAU_BOOTSTRAP.md
/MINI_PROMPT*.txt

# ---------------------------------------------------------------------------
# OS and editor noise
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Tooling output
# ---------------------------------------------------------------------------
node_modules/
dist/
# Local caches from running npx here rather than globally.
.npm-cache/
.playwright-browsers/
build/
coverage/
.cache/
*.log
npm-debug.log*
.env
.env.*
!.env.example
# An agent's own working state, not the project's configuration. `.claude/`
# itself stays trackable, so project-level settings, agents and commands can be
# committed deliberately if they are ever wanted — it is the scratch space
# underneath that must not be.
.claude/settings.local.json
/.claude/plans/
/.claude/worktrees/

# ---------------------------------------------------------------------------
# The modern-web-guidance skill
# ---------------------------------------------------------------------------
# `skills-lock.json` IS committed: it declares the source and a content hash, so
# the skill can be restored and verified. The materialised copy under `.agents/`
# is not — vendoring ~140 files of third-party guidance into the history is a
# different thing from declaring a dependency on it.
#
# The skill is mandatory (agent/modern-web-guidance.md). Restore it before
# working here.
# ---------------------------------------------------------------------------
/.agents/

# The audit's term list. Deliberately outside the repository — an audit that
# enumerates the names it searches for is the best place to find them.
# Create it from .whitelabel-terms.example.json.
/.whitelabel-terms.json

# One-off working scripts. A list of issues inside the repository goes stale the
# moment the issues exist, so it lives here rather than as a document.
/cleanup.sh
/ISSUES-TO-CREATE.md
/create-issues.sh

# Build and test output.
# `.tmp-ionicons/` is the upstream icon checkout that build-icons.mjs reads; the
# generated sprite IS committed, the source checkout is not.
/.tmp-ionicons/
/test-results/
/playwright-report/

# Working files that are yours, not Dessau's. Listed so a `git add -A` cannot pull
# them into the history by accident — which is exactly how one was lost once.
/logo-entwurf.png
/*.sketch
/*.fig
/*.afdesign
